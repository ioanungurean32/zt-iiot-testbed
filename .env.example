# Trust tokens are signed with ES256 (EC P-256). Generate the key pair once with:
#   docker compose run --rm loadgen python tools/generate_keys.py
# The private key stays with the token issuer (load generator); each PEP receives
# only the public verification key.
ZT_PRIVATE_KEY_FILE=/keys/zt_private.pem   # issuer only
ZT_PUBLIC_KEY_FILE=/keys/zt_public.pem     # PEPs (verification only)
KEYS_DIR=/keys
RESULTS_DIR=/app/results
