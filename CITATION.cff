cff-version: 1.2.0
title: "ZT-IIoT Multi-Protocol Testbed: Zero Trust Prototype for Modbus/TCP, MQTT, and OPC UA"
message: "If you use this testbed, please cite the associated manuscript and this software testbed."
type: software
version: "2.1.0"
date-released: "2026-08-20"
doi: "10.5281/zenodo.21300010"
